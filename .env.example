# Copy to .env and fill in. Never commit .env.

# API key for Anthropic (https://console.anthropic.com), or for an Anthropic-compatible gateway
# your organization provides.
LLM_API_KEY=
# Leave empty to use Anthropic's API. For a gateway: its root URL, without a trailing /v1.
LLM_BASE_URL=
# How the key is sent: "x-api-key" (Anthropic style, default) or "bearer" (Authorization: Bearer).
LLM_AUTH=x-api-key

# Models: worker (one call per email; a small model is enough) and manager (one call per digest).
SUMMARIZE_MODEL=claude-haiku-5-5
MANAGER_MODEL=claude-sonnet-5-5
